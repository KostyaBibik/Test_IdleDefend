  - m_Id: 2377113642
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113643
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0431\u0430\u0448\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113644
    m_Localized: "\u041D\u0430\u0434\u0435\u0436\u043D\u0430\u044F \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F
      \u0431\u0430\u0448\u043D\u044F. \u0412\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u0442\u043E\u0432\u0430
      \u043A \u043E\u0431\u043E\u0440\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113645
    m_Localized: "\u0410\u0440\u043A\u0430\u043D\u043E\u0432\u0430\u044F \u0431\u0430\u0448\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113646
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u044F\u044F \u043C\u0430\u0433\u0438\u044F
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113647
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F
      \u0431\u0430\u0448\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113648
    m_Localized: "\u0421\u0438\u044F\u0435\u0442 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439 \u0438 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113649
    m_Localized: "\u0422\u0435\u043C\u043D\u0430\u044F \u0431\u0430\u0448\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113650
    m_Localized: "\u0412\u044B\u043A\u043E\u0432\u0430\u043D\u0430 \u0432 \u0442\u0435\u043D\u0438.
      \u0412\u044B\u0431\u043E\u0440 \u0432\u0435\u0442\u0435\u0440\u0430\u043D\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113651
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113652
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
      \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441 \u0431\u0430\u0448\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113653
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113654
    m_Localized: "\u041F\u0440\u043E\u0436\u0438\u0433\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C. +18% \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113655
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113656
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113657
    m_Localized: "\u042F\u0434\u043E\u0432\u0438\u0442\u044B\u0439 \u0441\u043D\u0430\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113658
    m_Localized: "\u041E\u0442\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432,
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u0441\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113659
    m_Localized: "\u0423\u0440\u043E\u043D +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113660
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0430
      \u043A \u0443\u0440\u043E\u043D\u0443 \u0431\u0430\u0448\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113661
    m_Localized: "\u0420\u0430\u0434\u0438\u0443\u0441 +20%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113662
    m_Localized: "\u0411\u0430\u0448\u043D\u044F \u0434\u043E\u0441\u0442\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113663
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C +15%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113664
    m_Localized: "\u0411\u0430\u0448\u043D\u044F \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
      \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0447\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113665
    m_Localized: "\u0429\u0438\u0442 +25%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113666
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u0431\u0430\u0440\u044C\u0435\u0440,
      \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u044E\u0449\u0438\u0439 \u043E\u0431\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113667
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113668
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u0441 \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113669
    m_Localized: "\u041C\u0435\u0448\u043E\u043A \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113670
    m_Localized: "\u0423\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113671
    m_Localized: "\u0421\u0443\u043D\u0434\u0443\u043A \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113672
    m_Localized: "\u0422\u044F\u0436\u0435\u043B\u044B\u0439 \u0441\u0443\u043D\u0434\u0443\u043A,
      \u043F\u043E\u043B\u043D\u044B\u0439 \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113673
    m_Localized: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0441\u0443\u043D\u0434\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113674
    m_Localized: "\u0426\u0435\u043B\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u0432 \u044D\u043C\u0435\u0440\u0430\u043B\u044C\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113675
    m_Localized: "\u0423\u0440\u043E\u043D +15%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113676
    m_Localized: "\u0423\u0440\u043E\u043D \u0431\u0430\u0448\u043D\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0437\u0430\u0431\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113677
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      +12%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113678
    m_Localized: "\u0411\u0430\u0448\u043D\u044F \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0437\u0430\u0431\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113679
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113680
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438
      \u0431\u0430\u0448\u043D\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0437\u0430\u0431\u0435\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2377113681
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 2377113682
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u044B \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438
      \u0437\u0430 \u0432\u0440\u0430\u0433\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u044B
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0437\u0430\u0431\u0435\u0433\u0430."
